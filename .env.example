# Backend API base URL (must include /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
# Public URL of this site (SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:8080
# Optional: client-side image size limit in MB (keep in sync with backend UPLOAD_MAX_FILE_SIZE_MB)
NEXT_PUBLIC_UPLOAD_MAX_MB=5

